i5
Ints
Apply
    Using: (x) -> tuple(x, 0, length(x), 0)
Part "1":
    While
        Consider l Of (x) -> item(x, 2)
        Using: ((_, i, _, _)) -> i > -1 and i < l
        Apply
            Using: (x) -> consider i as item(x, 1) in
                consider c as item(x, 3) in
                consider steps as item(item(x, 0), i) in
                consider current_val as item(item(x, 0), i) in
                consider newl as set(item(x,0), i, current_val + 1) in
                tuple(newl, i + steps, l, c + 1)

    Apply
        Using: ((_, _, _, c)) -> c

    stdout

Part "2":
    While
        Consider l Of (x) -> item(x, 2)
        Using: ((_, i, _, _)) -> i > -1 and i < l
        Apply
            Using: (x) -> consider i as item(x, 1) in
                consider c as item(x, 3) in
                consider steps as item(item(x, 0), i) in
                consider current_val as item(item(x, 0), i) in
                consider newl as set(item(x,0), i, if current_val >= 3 then current_val - 1 else current_val + 1) in
                tuple(newl, i + steps, l, c + 1)

    Apply
        Using: ((_, _, _, c)) -> c

    stdout
