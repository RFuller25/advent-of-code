i9
Split ""
Cursed Object: i as 0
Cursed Object: groups as 0
Cursed Object: groups_semaphore as 0
Cursed Object: skip_flag as 0
Cursed Object: garbage_flag as 0
Cursed Object: garbage_count as 0
While
    Using: (x) -> i < length(x)
    Cursed Object: token of (x) -> item(x, i)
    Apply
        Using: (x) -> x also if skip_flag = 1 then skip_flag := 0 else
                    if token ="{"and garbage_flag = 0 then (groups_semaphore := groups_semaphore + 1) else
                    if token ="<"then (garbage_flag := 1) else
                    if token ="!"then (skip_flag := 1) + (garbage_count := garbage_count - 1) else
                    if token =">"and garbage_flag = 1 then (garbage_flag := 0) + (garbage_count := garbage_count - 1) else
                    if token ="}"and groups_semaphore > 0 and garbage_flag = 0 then (groups := groups + 1 + (groups_semaphore := groups_semaphore - 1)) else 0
    Apply
        Using: (x) -> x also i := i + 1
    Apply
        Using: (x) -> x also if (garbage_flag = 1 and skip_flag = 0) then (garbage_count := garbage_count + 1) else 0
Part "1":
    Apply
        Using: (x) -> groups
    stdout

Part "2":
    Apply
        Using: (x) -> garbage_count
    stdout
