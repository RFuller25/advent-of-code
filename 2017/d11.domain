i11

Split ","

Shikigami "FindDistance"
    Count By
        Using: (x) -> x
    Apply
        Using: (xs) -> consider x as getor(xs, "ne", 0) + getor(xs, "se", 0) - getor(xs, "sw", 0) - getor(xs, "nw", 0) in
            consider y as getor(xs, "n", 0) + getor(xs, "nw", 0) - getor(xs, "s", 0) - getor(xs, "se", 0) in
            consider z as getor(xs, "s", 0) + getor(xs, "sw", 0) - getor(xs, "n", 0) - getor(xs, "ne", 0) in
            (abs(x) + abs(y) + abs(z)) / 2

Part "1":
    FindDistance
    stdout

Part "2":
    Cursed Object: distances of (x) -> emptylist("")
    Map Each
        Apply
            Using: (x) -> distances := concat(distances, list(x))
        FindDistance
    Max
    stdout