# 2021 day 2: Dive!
#
#   puzzle:   d2.md
#   example:  i2 -> o2
#   real:     a2 (swap it in below)
Cursed Energy: a2
Lines
Map Each
    Using: (x) -> consider s as split(x, " ") in tuple(item(s, 0), toint(item(s, 1)))
Channel "Distance":
    Fold
        Seed: 0
        Using: (acc, x) -> acc + if item(x, 0) = "forward" then item(x, 1) else 0
Channel "Depth":
    Fold
        Seed: 0
        Using: (acc, x) -> acc + if item(x, 0) = "up" then item(x, 1) * -1
            else if item(x, 0) = "down" then item(x, 1) else 0
Part "1":
    Combine
        From: Distance, Depth
        Using: (di, de) -> di * de
    stdout

Part "2":
    Apply
        Using: (x) -> concat(x, list(tuple("done", -1)))
    Fold
        Consider depth As 0
        Consider distance As 0
        Consider aim As 0
        Seed: 0
        Using: (acc, x) -> if item(x, 0) = "forward" then distance := distance + item(x, 1)
            else if item(x, 0) = "up" then aim := aim - item(x, 1)
            else if item(x, 0) = "down" then aim := aim + item(x, 1)
            else depth * distance
            also if item(x, 0) = "forward" then depth := depth + aim * item(x, 1) else 0
    stdout
